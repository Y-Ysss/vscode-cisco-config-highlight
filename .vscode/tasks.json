// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "problemMatcher": {
        "owner": "rolldown",
        "pattern": {
          "regexp": "a^"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Waiting for changes\\.\\.\\.",
          "endsPattern": "Rebuilt out in .* ms\\."
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "never",
        "group": "watch"
      }
    },
    {
      "type": "npm",
      "script": "watch:types",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never",
        "group": "watch"
      }
    },
    {
      "label": "watch",
      "dependsOrder": "parallel",
      "dependsOn": ["npm: watch", "npm: watch:types"],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
